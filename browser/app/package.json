{
  "name": "@shared-workspace/browser-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "test:built": "node tests/acceptance.mjs && node tests/update.mjs && node tests/meeting.mjs",
    "test:update-mutations": "node tests/update-discovery-mutations.mjs evidence/update-discovery-mutations.json"
  },
  "dependencies": {
    "@shared-workspace/browser-host": "file:../host",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
